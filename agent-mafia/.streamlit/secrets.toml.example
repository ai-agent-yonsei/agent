# Streamlit Community Cloud > App settings > Secrets 에 붙여 넣고 값을 바꾸세요.
# 이 파일 자체는 저장소에 올리지 않아요(.gitignore).
# 키는 둘 중 하나만 넣어도 돼요. 둘 다 넣으면 Anthropic을 쓰고, PROVIDER = "openai" 로 바꿀 수 있어요.
ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
# PROVIDER = "openai"
# MODEL = "gpt-5-mini"
HOST_PASSWORD = "진행자-비밀번호"
PUBLIC_URL = "https://your-app-name.streamlit.app"
